# =============================================================================
# BioHub - variables de entorno (desarrollo local)
# Copia este archivo:  cp .env.example .env   y CAMBIA todas las contraseñas.
# El .env real NUNCA se sube al repo (está en .gitignore).
# Los servicios Spring Boot también leen este archivo (spring.config.import).
# No uses ${...} dentro de este archivo: Spring y Compose lo leen distinto.
# =============================================================================
COMPOSE_PROJECT_NAME=biohub

# --- MySQL local (perfil "local"). Cada base tiene DOS usuarios, como en Aiven (D39, SEC-11):
#   MYSQL_<X>_USER       usuario *_app: solo SELECT, INSERT, UPDATE, DELETE (lo usa el servicio)
#   <P>_MIGR_USER        usuario *_migr: además CREATE, ALTER, DROP, INDEX (solo lo usa Flyway)
# Los crea infra/mysql/initdb/01-usuarios.sh. levantar.ps1 los vuelve a ajustar en cada arranque y bloquea el
# historial de registro (D60): no hace falta borrar volúmenes al cambiar estas contraseñas si usas levantar.ps1.
# Si te faltan las *_MIGR_PASSWORD, levantar.ps1 las genera y las agrega al final de tu .env.

# --- MySQL transaccional (bases "cientifico" y "equipos")
MYSQL_TRANSACCIONAL_HOST=localhost
MYSQL_TRANSACCIONAL_PORT=3307
MYSQL_TRANSACCIONAL_ROOT_PASSWORD=cambiar_root_transaccional
MYSQL_CIENTIFICO_USER=cientifico_app
MYSQL_CIENTIFICO_PASSWORD=cambiar_cientifico
MYSQL_EQUIPOS_USER=equipos_app
MYSQL_EQUIPOS_PASSWORD=cambiar_equipos
CIENTIFICO_MIGR_USER=cientifico_migr
CIENTIFICO_MIGR_PASSWORD=cambiar_cientifico_migr
EQUIPOS_MIGR_USER=equipos_migr
EQUIPOS_MIGR_PASSWORD=cambiar_equipos_migr

# --- MySQL de lectura (servicio-consulta-publica)
MYSQL_LECTURA_HOST=localhost
MYSQL_LECTURA_PORT=3308
MYSQL_LECTURA_ROOT_PASSWORD=cambiar_root_lectura
MYSQL_LECTURA_USER=consulta_app
MYSQL_LECTURA_PASSWORD=cambiar_lectura
CONSULTA_MIGR_USER=consulta_migr
CONSULTA_MIGR_PASSWORD=cambiar_consulta_migr

# --- MySQL analítica (servicio-reportes)
MYSQL_ANALITICA_HOST=localhost
MYSQL_ANALITICA_PORT=3309
MYSQL_ANALITICA_ROOT_PASSWORD=cambiar_root_analitica
MYSQL_ANALITICA_USER=reportes_app
MYSQL_ANALITICA_PASSWORD=cambiar_analitica
REPORTES_MIGR_USER=reportes_migr
REPORTES_MIGR_PASSWORD=cambiar_reportes_migr

# --- MySQL gateway (API Keys y límites)
MYSQL_GATEWAY_HOST=localhost
MYSQL_GATEWAY_PORT=3310
MYSQL_GATEWAY_ROOT_PASSWORD=cambiar_root_gateway
MYSQL_GATEWAY_USER=gateway_app
MYSQL_GATEWAY_PASSWORD=cambiar_gateway
GATEWAY_MIGR_USER=gateway_migr
GATEWAY_MIGR_PASSWORD=cambiar_gateway_migr

# --- Aiven (perfil "aiven"; en el perfil "local" todo este bloque se ignora) ---------------------------
# D39: DOS servicios MySQL en Aiven y cada servicio apunta al suyo con su propio HOST/PORT:
#   ESCRITURA (servicio de Aiven 1): bases cientifico y equipos
#   LECTURA   (servicio de Aiven 2): bases consulta_publica, reportes y gateway
# Cada integrante rellena SOLO lo de su(s) servicio(s); host y puerto salen de la consola de Aiven
# (servicio -> Overview -> Connection information; el puerto NO es 3306). Usuario y contraseña de cada
# base (los de deploy/aiven/0X-*.sql) van mejor en el .env de la carpeta del servicio, ver su .env.example
# (CIENTIFICO_DB_USER/PASSWORD, EQUIPOS_..., CONSULTA_..., REPORTES_..., GATEWAY_..., y *_MIGR_USER/PASSWORD).
# Opcionales por base: <P>_DB_NAME, <P>_DB_CONNECT_TIMEOUT_MS (3000), <P>_DB_SOCKET_TIMEOUT_MS (30000).
# Sin perfil se puede dar la URL completa: <P>_DB_URL, <P>_DB_USER, <P>_DB_PASSWORD.
# Guia completa: docs/equipo/09-despliegue.md seccion 4. Descomenta y completa solo lo que uses.
#
# Servicio de ESCRITURA
# CIENTIFICO_DB_HOST=CAMBIAR.a.aivencloud.com
# CIENTIFICO_DB_PORT=00000
# EQUIPOS_DB_HOST=CAMBIAR.a.aivencloud.com
# EQUIPOS_DB_PORT=00000
# Servicio de LECTURA
# CONSULTA_DB_HOST=CAMBIAR.a.aivencloud.com
# CONSULTA_DB_PORT=00000
# REPORTES_DB_HOST=CAMBIAR.a.aivencloud.com
# REPORTES_DB_PORT=00000
# GATEWAY_DB_HOST=CAMBIAR.a.aivencloud.com
# GATEWAY_DB_PORT=00000
# Truststore PKCS12 con el CA de Aiven. Cada proyecto de Aiven tiene su propio CA: como los dos servicios estan
# en cuentas distintas, el truststore lleva AMBOS ca.pem (alias distintos); ver 09-despliegue.md 4.5. Ruta ABSOLUTA.
# AIVEN_TRUSTSTORE_PATH=/ruta/absoluta/a/certs/aiven-ca.p12
# AIVEN_TRUSTSTORE_PASSWORD=CAMBIAR
# AIVEN_SSL_MODE=VERIFY_CA

# --- Redis (caché de consulta pública)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambiar_redis
# REDIS_MAXMEMORY=256mb

# --- RabbitMQ (eventos asíncronos)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=biohub
RABBITMQ_PASSWORD=cambiar_rabbit
# Usuarios por servicio con permisos mínimos (SEC-04). Los crea el servicio rabbitmq-usuarios del compose.
# Para usarlos, cada servicio pone RABBITMQ_USER y RABBITMQ_PASSWORD en SU .env (ver docs/equipo/09-despliegue.md).
RABBITMQ_CIENTIFICO_USER=cientifico_mq
RABBITMQ_CIENTIFICO_PASSWORD=cambiar_rabbit_cientifico
RABBITMQ_CONSULTA_USER=consulta_mq
RABBITMQ_CONSULTA_PASSWORD=cambiar_rabbit_consulta
RABBITMQ_REPORTES_USER=reportes_mq
RABBITMQ_REPORTES_PASSWORD=cambiar_rabbit_reportes

# --- Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_admin_keycloak
# Contraseña de los 5 usuarios de prueba del realm (se inyecta al importar el realm)
KEYCLOAK_TEST_USERS_PASSWORD=cambiar_usuarios_prueba
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/biohub
KEYCLOAK_AUDIENCE=biohub-api
# Secreto del cliente biohub-gateway: el gateway administra usuarios con él (HU-10). Solo letras y números.
KEYCLOAK_GATEWAY_CLIENT_SECRET=cambiar_secreto_gateway
# Opcionales (valor por defecto): KEYCLOAK_REALM (biohub), KEYCLOAK_GATEWAY_CLIENT_ID (biohub-gateway),
# KEYCLOAK_ADMIN_URL (http://localhost:<KEYCLOAK_PORT>)

# --- Puertos de los servicios
API_GATEWAY_PORT=8080
SERVICIO_CIENTIFICO_PORT=8081
SERVICIO_EQUIPOS_PORT=8082
SERVICIO_CONSULTA_PUBLICA_PORT=8083
SERVICIO_REPORTES_PORT=8084
# A dónde envía el gateway cada prefijo (y consulta-publica pide las fotos públicas al científico, D65). En contenedores
# apuntan a la red interna; en local, por defecto, a localhost con los puertos de arriba.
# SERVICIO_CIENTIFICO_URL=http://localhost:8081
# SERVICIO_EQUIPOS_URL=http://localhost:8082
# SERVICIO_CONSULTA_PUBLICA_URL=http://localhost:8083
# SERVICIO_REPORTES_URL=http://localhost:8084
# Los servicios escuchan solo en 127.0.0.1 para obligar a entrar por el gateway. En contenedores: 0.0.0.0 en red interna.
# SERVER_ADDRESS=127.0.0.1
# Orígenes que el gateway acepta (CORS): las dos webs
# CORS_ORIGENES=http://localhost:5173,http://localhost:5174

# --- api-gateway: límites y circuito (todas opcionales; valor por defecto)
# GATEWAY_LIMITE_CONSUMIDOR_POR_MINUTO=60    # RNF11: por API Key, si el consumidor no tiene uno propio
# GATEWAY_LIMITE_IP_PORTAL_POR_MINUTO=120    # portal público sin login, por IP
# GATEWAY_LIMITE_FALLOS_KEY_POR_MINUTO=20    # intentos con una key inválida antes de bloquear la IP
# GATEWAY_CIRCUITO_FALLOS=5
# GATEWAY_CIRCUITO_TIEMPO_ABIERTO=10s
# Teselas del mapa (D56): proveedor, caché y límite por usuario
# GATEWAY_TESELAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GATEWAY_TESELAS_CACHE=64MB
# GATEWAY_TESELAS_POR_USUARIO=600

# --- servicio-cientifico: llaves de cifrado de coordenadas (ASR6)
# Formato: v1:<32 bytes en Base64>[,v2:...]. En local, levantar.ps1 genera una si falta. En Aiven debe ser la MISMA
# llave del equipo (si no, las coordenadas ya cifradas no se pueden leer). Nunca la subas al repo.
# UBICACION_CLAVES=v1:CAMBIAR
# UBICACION_CLAVE_ACTIVA=v1
# Alternativa a la variable: un keystore PKCS12 (UBICACION_LLAVES_PROVEEDOR=keystore)
# UBICACION_LLAVES_PROVEEDOR=entorno
# UBICACION_KEYSTORE_RUTA=/ruta/absoluta/llaves.p12
# UBICACION_KEYSTORE_PASSWORD=CAMBIAR
# Solo para pruebas: llave efímera que se pierde al reiniciar
# UBICACION_LLAVE_EFIMERA_DEV=false

# --- servicio-cientifico: carpeta de evidencias (fotos y audios, D62). Opcional; nunca dentro de un repo.
# EVIDENCIAS_DIR=./datos/evidencias

# --- servicio-reportes: cron del reporte mensual automatico (D61). Opcional; "-" lo desactiva.
# REPORTES_PROGRAMACION=0 0 3 1 * *

# --- servicio-consulta-publica (todas opcionales; valores por defecto entre paréntesis)
# Modo degradado (RNF1): si es true se ignoran los filtros familia y departamento (false)
CONSULTA_MODO_DEGRADADO=false
# Verificar el user_id AMQP del publicador de hallazgo.* (ARQ-13, SEC-J-01, SEC-J-11). true por defecto: un evento sin
# user_id, o con uno distinto del esperado, va a la DLQ. false SOLO en pruebas locales sin publicador (el servicio avisa
# con un WARN). servicio-cientifico fija user_id = RABBITMQ_USER en cada evento (PublicadorEventos).
BIOHUB_EVENTOS_VERIFICAR_PUBLICADOR=true
# Usuario AMQP esperado del publicador: debe ser el usuario con que publica servicio-cientifico. En el Compose de
# desarrollo todos los servicios usan RABBITMQ_USER (biohub), asi que debe valer lo mismo que RABBITMQ_USER; si no, todo
# evento de cientifico se rechaza. cientifico_mq solo aplica cuando existan usuarios AMQP por servicio (SEC-04).
BIOHUB_EVENTOS_PUBLICADOR_CIENTIFICO=biohub

# --- Webs (Vite). Las lee cada web de SU carpeta (web-interna/.env.local, web-publica/.env.local) al compilar;
# levantar.ps1 las pone solo. También definen la CSP de cada web (origen del gateway y de Keycloak).
# VITE_API_URL=http://localhost:8080
# VITE_KEYCLOAK_URL=http://localhost:8180      # solo web-interna
# VITE_KEYCLOAK_REALM=biohub                   # solo web-interna
# VITE_KEYCLOAK_CLIENT_ID=web-interna          # solo web-interna
