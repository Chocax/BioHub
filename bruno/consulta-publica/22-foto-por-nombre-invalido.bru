meta {
  name: foto-por-nombre-invalido
  type: http
  seq: 22
}

get {
  url: {{baseConsulta}}/api/publica/especies/foto?nombre=%3Cscript%3E
  body: none
  auth: none
}

params:query {
  nombre: <script>
}

tests {
  test("400 PARAMETRO_INVALIDO sobre el campo nombre", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().codigo).to.equal("PARAMETRO_INVALIDO");
    expect(res.getBody().errores[0].campo).to.equal("nombre");
  });
}

docs {
  Ruta de compatibilidad (la foto pública más reciente de la especie, de la base de lectura). Contrato 04 §4.4.
}
