meta {
  name: foto-por-id-invalido
  type: http
  seq: 20
}

get {
  url: {{baseConsulta}}/api/publica/especies/fotos/no-es-un-uuid
  body: none
  auth: none
}

tests {
  test("400 PARAMETRO_INVALIDO sobre el campo fotoId, sin caché", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().codigo).to.equal("PARAMETRO_INVALIDO");
    expect(res.getBody().errores[0].campo).to.equal("fotoId");
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });
}

docs {
  Contrato 04 §4.4 (D66): fotoId que no es un UUID.
}
